          "content": {
            "mimeType": "application/json",
            "size": 6373,
            "text": "{\"status\": \"published\", \"survey_id\": \"784178168102846465\", \"template_id\": \"None\", \"last_updated\": null, \"uid\": \"784178168134008833\", \"config\": {\"description\": \"Major Cases questions for tips.fbi.gov/beta\", \"logoPosition\": \"right\", \"pages\": [{\"description\": \"Would you like to report a business or corporation as the victim of computer intrusion?\", \"elements\": [{\"choices\": [{\"text\": \"yes\", \"value\": \"item1\"}, {\"text\": \"no\", \"value\": \"item2\"}], \"name\": \"businessAffected\", \"title\": \"Was a business affected?\", \"type\": \"radiogroup\", \"visible\": false}, {\"name\": \"whichBusiness\", \"title\": \"Which business was affected?\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{businessAffected} = 'item1'\"}, {\"name\": \"question2\", \"title\": \"When did the intrusion occur?\", \"type\": \"comment\"}, {\"choices\": [\"physical access\", \"internet attacking IP address\", \"email\", \"other\", \"don't know\"], \"name\": \"howCompromised\", \"title\": \"How was the system compromised?\", \"type\": \"dropdown\"}, {\"name\": \"howCompromisedSpecifyOther\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{howCompromised} = 'other'\"}, {\"indent\": 5, \"name\": \"question8\", \"title\": \"From where?\", \"type\": \"comment\"}, {\"name\": \"question9\", \"title\": \"SCREENBREAK\", \"type\": \"text\"}, {\"choices\": [{\"text\": \"DoS\", \"value\": \"item1\"}, {\"text\": \"DDoS\", \"value\": \"item2\"}, {\"text\": \"Trojan\", \"value\": \"item3\"}, {\"text\": \"virus\", \"value\": \"item4\"}, {\"text\": \"ransomware\", \"value\": \"item5\"}, {\"text\": \"other\", \"value\": \"item6\"}], \"name\": \"natureOfAttack\", \"title\": \"What was the nature of the attack?\", \"type\": \"dropdown\"}, {\"name\": \"natureOfAttackSpecifyOther\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{natureOfAttack} = 'item6'\"}, {\"choices\": [\"down time\", \"money loss\", \"data deleted, lost, altered, or copied\", \"compromised personally identifiable information\", \"proprietary information obtained\", \"malicious code inserted\", \"passwords stolen\", \"other\"], \"name\": \"impactOfIntrusion\", \"title\": \"What was the impact of the intrusion?\", \"type\": \"checkbox\"}, {\"name\": \"impactOfIntrusionSpecifyOther\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{impactOfIntrusion} = ['other']\"}, {\"name\": \"question10\", \"title\": \"SCREENBREAK\", \"type\": \"text\"}, {\"name\": \"question11\", \"title\": \"What type of computer system was compromised?\", \"type\": \"comment\"}, {\"name\": \"question12\", \"title\": \"What files were encrypted/ accessed during the computer intrusion?\", \"type\": \"comment\"}, {\"name\": \"question13\", \"title\": \"Provide a brief description of the incident\", \"type\": \"comment\"}], \"name\": \"Major Case Template\", \"title\": \"Computer Intrusion Clone\", \"visible\": false}, {\"description\": \"Would you like to report a business or corporation as the victim of computer intrusion?\", \"elements\": [{\"choices\": [{\"text\": \"yes\", \"value\": \"item1\"}, {\"text\": \"no\", \"value\": \"item2\"}], \"name\": \"question7\", \"title\": \"Was a business affected?\", \"type\": \"radiogroup\"}, {\"name\": \"question14\", \"title\": \"Which business was affected?\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{question7} = 'item1'\"}, {\"name\": \"question15\", \"title\": \"When did the intrusion occur?\", \"type\": \"comment\"}, {\"choices\": [\"physical access\", \"internet attacking IP address\", \"email\", \"other\", \"don't know\"], \"name\": \"question16\", \"title\": \"How was the system compromised?\", \"type\": \"dropdown\"}, {\"name\": \"question17\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{question16} = 'other'\"}, {\"indent\": 5, \"name\": \"question18\", \"title\": \"From where?\", \"type\": \"comment\"}, {\"name\": \"question19\", \"title\": \"SCREENBREAK\", \"type\": \"text\"}, {\"choices\": [{\"text\": \"DoS\", \"value\": \"item1\"}, {\"text\": \"DDoS\", \"value\": \"item2\"}, {\"text\": \"Trojan\", \"value\": \"item3\"}, {\"text\": \"virus\", \"value\": \"item4\"}, {\"text\": \"ransomware\", \"value\": \"item5\"}, {\"text\": \"other\", \"value\": \"item6\"}], \"name\": \"question20\", \"title\": \"What was the nature of the attack?\", \"type\": \"dropdown\"}, {\"name\": \"question21\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{question20} = 'item6'\"}, {\"choices\": [\"down time\", \"money loss\", \"data deleted, lost, altered, or copied\", \"compromised personally identifiable information\", \"proprietary information obtained\", \"malicious code inserted\", \"passwords stolen\", \"other\"], \"name\": \"question22\", \"title\": \"What was the impact of the intrusion?\", \"type\": \"checkbox\"}, {\"name\": \"question23\", \"title\": \"Specify Other\", \"type\": \"text\", \"visible\": false, \"visibleIf\": \"{question22} = ['other']\"}, {\"name\": \"question24\", \"title\": \"SCREENBREAK\", \"type\": \"text\"}, {\"name\": \"question25\", \"title\": \"What type of computer system was compromised?\", \"type\": \"comment\"}, {\"name\": \"question26\", \"title\": \"What files were encrypted/ accessed during the computer intrusion?\", \"type\": \"comment\"}, {\"name\": \"question27\", \"title\": \"Provide a brief description of the incident\", \"type\": \"comment\"}], \"name\": \"Computer Intrusion Clone\", \"title\": \"Computer Intrusion Clone\", \"visible\": false}, {\"description\": \"The questions on this survey show up on tips.fbi.gov/beta if the question set is marked as visible. This page (\\\"Directions\\\") and the page titled \\\"Major Case Template\\\" will never be visible.\", \"elements\": [{\"html\": \"<h2 style=\\\"font-style:italic;\\\">Defining a new major case question set</h2>\\n\\n<p>Creating a new tab at the top of this Survey create a new major case question set.</p>\\n\", \"name\": \"Defining a major case\", \"type\": \"html\"}, {\"html\": \"<h2 style=\\\"font-style:italic;\\\">Question Set Options</h2>\\n\", \"name\": \"Question Set Options\", \"type\": \"html\"}, {\"html\": \"<h2 style=\\\"font-style:italic;\\\">Adding and Editing Questions</h2>\\n\", \"name\": \"question1\", \"type\": \"html\"}, {\"html\": \"<h2 style=\\\"font-style:italic;\\\">Publishing a Major Case Question Set</h2>\\n\", \"name\": \"question3\", \"type\": \"html\"}, {\"html\": \"<h2 style=\\\"font-style:italic;\\\">Copying from Beta Survey&nbsp;to Production Survey</h2>\\n\", \"name\": \"question4\", \"type\": \"html\"}], \"name\": \"Directions\", \"title\": \"Directions for using this question builder for tips questions\", \"visible\": false}, {\"elements\": [{\"name\": \"question5\", \"type\": \"text\"}, {\"choices\": [\"item1\", \"item2\", \"item3\"], \"name\": \"question6\", \"type\": \"checkbox\"}], \"name\": \"page1\"}], \"showQuestionNumbers\": \"off\", \"title\": \"Tips Major Cases Editor - Beta\"}, \"created_on\": \"August 01, 2022 at 07:36PM\"}"
